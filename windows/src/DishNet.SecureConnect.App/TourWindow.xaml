<Window x:Class="DishNet.SecureConnect.App.TourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="How DishNet Secure Connect works" Width="720" Height="560" MinWidth="640" MinHeight="520"
        Background="White" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Animated flow: Office PC (Tally stays here) → encrypted DishNet tunnel → remote laptop showing the office desktop.
             Pure XAML shapes + storyboards, no external assets. Storyboards are stopped when Windows animations are off. -->
        <Storyboard x:Key="TunnelFlow" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="TunnelDashes" Storyboard.TargetProperty="StrokeDashOffset" From="24" To="0" Duration="0:0:1.2"/>
            <DoubleAnimation Storyboard.TargetName="Packet" Storyboard.TargetProperty="(Canvas.Left)" From="214" To="438" Duration="0:0:2.4" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="Lock" Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:1.2" AutoReverse="True"/>
        </Storyboard>
        <Style x:Key="Step" TargetType="Border">
            <Setter Property="Background" Value="#F7F7F8"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="StepActive" TargetType="Border" BasedOn="{StaticResource Step}">
            <Setter Property="BorderBrush" Value="#D7262D"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#D7262D" Padding="20,14">
            <StackPanel>
                <TextBlock Foreground="White" FontSize="19" FontWeight="Bold" Text="Access your office computer securely from anywhere"/>
                <TextBlock Foreground="White" Opacity="0.9" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Your Tally and company data stay on the office computer. DishNet makes an encrypted connection, and Remote Desktop lets you work on that computer as if you were sitting there."/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="20,12" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" x:Name="StepCounter" VerticalAlignment="Center" Foreground="#6B7280" FontSize="12.5"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackBtn" Click="Back_Click" Style="{StaticResource Secondary}" Content="Back" Margin="0,0,8,0" IsCancel="False"/>
                    <Button x:Name="NextBtn" Click="Next_Click" Style="{StaticResource Primary}" Content="Next" IsDefault="True"/>
                    <Button x:Name="SkipBtn" Click="Skip_Click" Style="{StaticResource Secondary}" Content="Watch later" Margin="8,0,0,0" IsCancel="True"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="20,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- Step tabs (also keyboard: Left/Right arrows) -->
            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,-8,12">
                <Border x:Name="Tab1" Style="{StaticResource StepActive}"><StackPanel><TextBlock FontWeight="SemiBold" Text="1 · Your office computer"/><TextBlock Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" Text="Tally and the data stay here."/></StackPanel></Border>
                <Border x:Name="Tab2" Style="{StaticResource Step}"><StackPanel><TextBlock FontWeight="SemiBold" Text="2 · Connect with DishNet"/><TextBlock Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" Text="An encrypted tunnel, only for your devices."/></StackPanel></Border>
                <Border x:Name="Tab3" Style="{StaticResource Step}"><StackPanel><TextBlock FontWeight="SemiBold" Text="3 · Open your office desktop"/><TextBlock Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" Text="Remote Desktop shows the office screen."/></StackPanel></Border>
            </UniformGrid>

            <!-- The picture -->
            <Viewbox Grid.Row="1" Stretch="Uniform" MaxHeight="260">
                <Canvas Width="660" Height="220" x:Name="Scene" AutomationProperties.Name="Diagram: office computer with Tally, encrypted DishNet connection, remote laptop showing the office desktop">
                    <!-- Office PC -->
                    <Rectangle x:Name="OfficePc" Canvas.Left="40" Canvas.Top="40" Width="160" Height="110" RadiusX="8" RadiusY="8" Fill="White" Stroke="#1F2328" StrokeThickness="2"/>
                    <Rectangle Canvas.Left="100" Canvas.Top="152" Width="40" Height="14" Fill="#1F2328"/>
                    <Rectangle Canvas.Left="80" Canvas.Top="166" Width="80" Height="5" Fill="#1F2328"/>
                    <Border Canvas.Left="58" Canvas.Top="56" Width="124" Height="78" Background="#F7F7F8" CornerRadius="4">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Tally" FontWeight="Bold" FontSize="20" Foreground="#1F2328" HorizontalAlignment="Center"/>
                            <TextBlock Text="company data" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Canvas.Left="40" Canvas.Top="186" Width="160" TextAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Text="Office computer"/>
                    <TextBlock Canvas.Left="40" Canvas.Top="203" Width="160" TextAlignment="Center" FontSize="11" Foreground="#6B7280" Text="stays on, data stays here"/>

                    <!-- Tunnel -->
                    <Line x:Name="TunnelOuter" X1="210" Y1="95" X2="450" Y2="95" Stroke="#FDE2E3" StrokeThickness="26" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line x:Name="TunnelDashes" X1="214" Y1="95" X2="446" Y2="95" Stroke="#D7262D" StrokeThickness="4" StrokeDashArray="6 6" StrokeDashOffset="0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Ellipse x:Name="Packet" Canvas.Left="214" Canvas.Top="87" Width="16" Height="16" Fill="#D7262D"/>
                    <!-- padlock -->
                    <Canvas x:Name="Lock" Canvas.Left="316" Canvas.Top="52">
                        <Rectangle Canvas.Left="4" Canvas.Top="12" Width="24" Height="18" RadiusX="3" RadiusY="3" Fill="#D7262D"/>
                        <Path Data="M8,12 V8 A8,8 0 0 1 24,8 V12" Stroke="#D7262D" StrokeThickness="3" Fill="Transparent"/>
                    </Canvas>
                    <TextBlock Canvas.Left="210" Canvas.Top="118" Width="240" TextAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Text="Encrypted DishNet connection"/>
                    <TextBlock Canvas.Left="210" Canvas.Top="135" Width="240" TextAlignment="Center" FontSize="11" Foreground="#6B7280" Text="only your authorised devices · nothing is copied"/>

                    <!-- Laptop -->
                    <Rectangle Canvas.Left="470" Canvas.Top="48" Width="160" Height="100" RadiusX="6" RadiusY="6" Fill="White" Stroke="#1F2328" StrokeThickness="2"/>
                    <Rectangle Canvas.Left="455" Canvas.Top="150" Width="190" Height="10" RadiusX="3" RadiusY="3" Fill="#1F2328"/>
                    <Border x:Name="RemoteScreen" Canvas.Left="482" Canvas.Top="60" Width="136" Height="76" Background="#F7F7F8" CornerRadius="3" Opacity="0.35">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Office desktop" FontSize="10" Foreground="#6B7280" HorizontalAlignment="Center"/>
                            <TextBlock Text="Tally" FontWeight="Bold" FontSize="16" Foreground="#1F2328" HorizontalAlignment="Center"/>
                            <TextBlock Text="via Remote Desktop" FontSize="9" Foreground="#6B7280" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Canvas.Left="460" Canvas.Top="186" Width="180" TextAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Text="Your laptop, anywhere"/>
                    <TextBlock Canvas.Left="460" Canvas.Top="203" Width="180" TextAlignment="Center" FontSize="11" Foreground="#6B7280" Text="sees and controls the office screen"/>
                </Canvas>
            </Viewbox>

            <!-- Caption for the current step -->
            <Border Grid.Row="2" Background="#F7F7F8" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock x:Name="CaptionTitle" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CaptionBody" FontSize="13.5" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="20"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
