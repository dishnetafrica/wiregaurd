<Window x:Class="DishNet.SecureConnect.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DishNet Secure Connect" Width="460" Height="620" MinWidth="420" MinHeight="560"
        Background="{StaticResource Page}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>
    </Window.Resources>
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BrandRed}" Padding="24,18">
            <StackPanel>
                <TextBlock Foreground="White" FontSize="20" FontWeight="Bold">DishNet <Run FontWeight="Normal">Secure Connect</Run></TextBlock>
                <TextBlock Foreground="White" Opacity="0.85" FontSize="12">Secure access to your office from anywhere</TextBlock>
            </StackPanel>
        </Border>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Padding="24,10" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="White">
            <DockPanel>
                <TextBlock Style="{StaticResource MutedText}" FontSize="11" DockPanel.Dock="Right" Text="{Binding Version}"/>
                <TextBlock Style="{StaticResource MutedText}" FontSize="11">Encrypted connection · Authorized devices only · Powered by WireGuard®</TextBlock>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">

                <!-- Activation -->
                <StackPanel Visibility="{Binding ShowActivation, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource H1}" Margin="0,0,0,6">Activate this device</TextBlock>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,16">Enter the activation code you received from DishNet. Each code works once and registers only this computer.</TextBlock>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,4">Activation code</TextBlock>
                    <TextBox Style="{StaticResource Field}" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="26" ToolTip="Looks like DN-XXXX-XXXX-XXXX-XXXX"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,12,0,4">Device name (shown to DishNet)</TextBlock>
                    <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="14" MaxLength="64"/>
                    <Button Style="{StaticResource Primary}" Command="{Binding ActivateCommand}" Margin="0,18,0,0" HorizontalAlignment="Left">Activate</Button>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,16,0,0" FontSize="12">Windows asked for administrator permission when you opened this app: it is needed to install the DishNet secure tunnel as a Windows service. Your private key is created on this computer and never leaves it.</TextBlock>
                </StackPanel>

                <!-- Main -->
                <StackPanel Visibility="{Binding ShowMain, Converter={StaticResource Vis}}">
                    <Border CornerRadius="8" Padding="16" Margin="0,0,0,16" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12">VPN status</TextBlock>
                            <TextBlock Text="{Binding StateTitle}" FontSize="26" FontWeight="SemiBold" Margin="0,2,0,2"/>
                            <TextBlock Text="{Binding StateDetail}" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding PlanText}" FontSize="13" Foreground="{StaticResource Warn}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding GatewayNote}" Style="{StaticResource MutedText}" Margin="0,4,0,0" Visibility="{Binding HasGatewayNote, Converter={StaticResource Vis}}"/>
                            <TextBlock Text="{Binding Handshake}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding Traffic}" Style="{StaticResource MutedText}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource Primary}" Command="{Binding ConnectCommand}" Content="Connect to Office" x:Name="ConnectBtn"/>
                                <Button Style="{StaticResource Secondary}" Command="{Binding DisconnectCommand}" Content="Disconnect" Margin="10,0,0,0" x:Name="DisconnectBtn"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8" Padding="16" Margin="0,0,0,16" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource MutedText}">Business</TextBlock>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CustomerName}"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource MutedText}">This device</TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AssignedDevice}"/>
                            <TextBlock Grid.Row="2" Style="{StaticResource MutedText}">VPN address</TextBlock>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VpnAddress}" FontFamily="Consolas"/>
                            <TextBlock Grid.Row="3" Style="{StaticResource MutedText}">Office access</TextBlock>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OfficeTargets}"/>
                        </Grid>
                    </Border>

                    <CheckBox IsChecked="{Binding StartWithWindows}" Margin="0,0,0,12">Start DishNet Secure Connect with Windows</CheckBox>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Secondary}" Command="{Binding DiagnosticsCommand}">Save diagnostics…</Button>
                        <Button Style="{StaticResource Secondary}" Command="{Binding ForgetCommand}" Margin="10,0,0,0">Reset this device</Button>
                    </StackPanel>
                </StackPanel>

                <!-- Update banner -->
                <Border Background="{StaticResource WarnSoft}" CornerRadius="6" Padding="12,8" Margin="0,16,0,0" Visibility="{Binding HasUpdate, Converter={StaticResource Vis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Secondary}" Command="{Binding UpdateCommand}" Content="Update now" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding UpdateText}" Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </DockPanel>
                </Border>

                <!-- Messages -->
                <Border Background="{StaticResource BadSoft}" CornerRadius="6" Padding="12,8" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Bad}"/>
                </Border>
                <Border Background="{StaticResource OkSoft}" CornerRadius="6" Padding="12,8" Margin="0,10,0,0" Visibility="{Binding HasInfo, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding Info}" Foreground="{StaticResource Ok}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
