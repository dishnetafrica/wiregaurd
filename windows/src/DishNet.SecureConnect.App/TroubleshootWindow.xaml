<Window x:Class="DishNet.SecureConnect.App.TroubleshootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What is not working?" Width="560" Height="520" MinWidth="480" MinHeight="420"
        Background="White" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource BrandRed}" Padding="20,12">
            <StackPanel>
                <TextBlock Foreground="White" FontSize="18" FontWeight="Bold" Text="Troubleshooting assistant"/>
                <TextBlock Foreground="White" Opacity="0.9" FontSize="12.5" TextWrapping="Wrap" Text="Finds which part is failing: activation, the DishNet connection, the office computer, Remote Desktop, your Windows sign-in, or Tally itself — and who can fix it."/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="20,10" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="Restart_Click" Style="{StaticResource Secondary}" Content="Start again"/>
                <Button Click="Diagnostics_Click" Style="{StaticResource Secondary}" Content="Save diagnostics…" Margin="10,0,0,0"/>
                <Button Click="Contact_Click" Style="{StaticResource Secondary}" Content="Contact DishNet support" Margin="10,0,0,0"/>
                <Button Click="Close_Click" Style="{StaticResource Secondary}" Content="Close" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,8" Text="Checked by the software just now:"/>
                <TextBlock x:Name="Observed" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <Border x:Name="QuestionBox" Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource Warn}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="Question" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Click="Yes_Click" Style="{StaticResource Primary}" Content="Yes"/>
                            <Button Click="No_Click" Style="{StaticResource Secondary}" Content="No" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="ResultBox" CornerRadius="8" Padding="14" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock x:Name="LayerText" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="DiagTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,6"/>
                        <TextBlock x:Name="Explanation" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock FontWeight="SemiBold" FontSize="13" Text="What to do"/>
                        <TextBlock x:Name="WhatToDo" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <TextBlock x:Name="Who" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
