<Window x:Class="DishNet.SecureConnect.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DishNet Secure Connect — Help" Width="820" Height="600" MinWidth="700" MinHeight="480"
        Background="White" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#D7262D" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Click="Tour_Click" Style="{StaticResource Secondary}" Content="Watch the 2-minute tour"/>
                <StackPanel>
                    <TextBlock Foreground="White" FontSize="18" FontWeight="Bold" Text="Help centre"/>
                    <TextBlock x:Name="SupportLine" Foreground="White" Opacity="0.9" FontSize="12.5"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="Topics" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="#E5E7EB" SelectionChanged="Topics_SelectionChanged" Padding="6"
                     AutomationProperties.Name="Help topics">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Padding="8,7" TextWrapping="Wrap" FontSize="13.5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
                <StackPanel>
                    <TextBlock x:Name="TopicTitle" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TopicBody" FontSize="14" LineHeight="22" TextWrapping="Wrap"/>
                    <Border Background="#F7F7F8" CornerRadius="8" Padding="14" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Still stuck?"/>
                            <TextBlock x:Name="ContactBody" TextWrapping="Wrap" Foreground="#6B7280" FontSize="13" Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Click="Diagnostics_Click" Style="{StaticResource Secondary}" Content="Save diagnostics…"/>
                                <Button Click="Contact_Click" Style="{StaticResource Primary}" Content="Contact DishNet support" Margin="10,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
