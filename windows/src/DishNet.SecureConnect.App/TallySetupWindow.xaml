<Window x:Class="DishNet.SecureConnect.App.TallySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up Tally remote access" Width="640" Height="700" MinWidth="560" MinHeight="560"
        Background="White" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources><BooleanToVisibilityConverter x:Key="Vis"/></Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource BrandRed}" Padding="20,12">
            <StackPanel>
                <TextBlock Foreground="White" FontSize="18" FontWeight="Bold" Text="Set up Tally remote access"/>
                <TextBlock Foreground="White" Opacity="0.9" FontSize="12.5" TextWrapping="Wrap"
                           Text="Tally runs on your office computer. You see it through Remote Desktop, over DishNet's private connection. Follow the steps once as a practice run; afterwards it is just Connect → Open Remote Desktop."/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="20,10" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Click="Trouble_Click" Style="{StaticResource Secondary}" Content="Something is not working…"/>
                    <Button Click="Close_Click" Style="{StaticResource Secondary}" Content="Close" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="ProgressText" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,14">
            <StackPanel>
                <Border x:Name="DoneBanner" Background="{StaticResource OkSoft}" CornerRadius="8" Padding="14" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource Ok}" Text="Practice run complete — you can work in Tally from here"/>
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8" Text="Next time: open DishNet Secure Connect → Connect to Office → Open Remote Desktop → sign in → open Tally. Finish with: close the company in Tally → close Remote Desktop → Disconnect."/>
                        <Button Click="Practice_Click" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Content="Practise again"/>
                    </StackPanel>
                </Border>
                <ItemsControl x:Name="Steps" AutomationProperties.Name="Tally remote access steps">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="12,10" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{StaticResource Line}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Background" Value="{StaticResource WarnSoft}"/><Setter Property="BorderBrush" Value="{StaticResource Warn}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Width="26" FontSize="16" VerticalAlignment="Top" Margin="0,0,6,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Text" Value="{Binding Number}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Step.Status}" Value="Verified"><Setter Property="Text" Value="✔"/><Setter Property="Foreground" Value="{StaticResource Ok}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Step.Status}" Value="Confirmed"><Setter Property="Text" Value="✔"/><Setter Property="Foreground" Value="{StaticResource Ok}"/></DataTrigger>
                                                    <DataTrigger Binding="{Binding Step.Status}" Value="Attention"><Setter Property="Text" Value="!"/><Setter Property="Foreground" Value="{StaticResource Bad}"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Step.Title}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding Step.Instruction}" Style="{StaticResource MutedText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding SourceLabel}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                                        <WrapPanel Margin="0,8,0,0" Visibility="{Binding IsCurrent, Converter={StaticResource Vis}}">
                                            <Button Style="{StaticResource Primary}" Content="{Binding ActionLabel}" Click="Action_Click" Tag="{Binding}" Visibility="{Binding HasAction, Converter={StaticResource Vis}}" Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource Secondary}" Content="{Binding ConfirmLabel}" Click="Confirm_Click" Tag="{Binding}" Visibility="{Binding CanConfirm, Converter={StaticResource Vis}}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="✔ in green = checked by the software or confirmed by you. DishNet never asks for your Windows or Tally password. A normal Windows PC lets one person at a time work through Remote Desktop; for several people at once ask DishNet about a Windows Server assessment."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
